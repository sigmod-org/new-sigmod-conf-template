{%- import "_shared/macros.njk" as m -%}
{%- set home = page.url == "/" -%}
{%- set g = page.url | groupOf -%}
<!doctype html>
<html lang="en">
<head>
{% include "_shared/head.njk" %}
</head>
<body class="theme-masthead{% if home %} is-home{% endif %}">
<a class="skip" href="#main">Skip to content</a>
<div class="utility"><div class="wrap">
  <span><a href="https://sigmod.org/">ACM SIGMOD</a> · <a href="https://sigmod.org/pods/">PODS</a></span>
  <span class="u-when">{{ conf.dates }} · {{ conf.location }}</span>
</div></div>
{% if site.announcement %}<div class="announce"><div class="wrap">{{ site.announcement | inline | safe }}</div></div>{% endif %}

<header class="masthead">
  <div class="wrap top">
    <a class="brand" href="/">
      <span class="logo">{% logo "h" %}</span>
      <span class="txt"><span class="name">{{ conf.short_name | yearEm | safe }}</span><span class="full">{{ conf.full_name }}</span></span>
    </a>
    <a class="btn reg" href="{{ conf.register_link }}">Register</a>
    <button class="menubtn" data-menu aria-expanded="false" aria-controls="drawer">Menu</button>
  </div>
  <nav class="mainnav" aria-label="Site">
    <ul class="wrap">
      <li class="{% if home %}cur{% endif %}"><a class="top-a" href="/"{% if home %} aria-current="page"{% endif %}>Home</a></li>
      {%- for grp in nav.all %}{% if not loop.first %}
      <li class="has-dd{% if grp == g %} cur{% endif %}">
        <a class="top-a" href="{{ grp.first.href }}">{{ grp.short }}</a>
        <div class="dd"><p class="dd-h">{{ grp.name }}</p>{{ m.items(grp.items, page.url) }}</div>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </nav>
</header>
<nav class="drawer" id="drawer" aria-label="Site (phone)"><div class="wrap">{{ m.drawer(nav.all, page.url, conf) }}</div></nav>

{% if home %}
<div class="banner"><img src="/{{ conf.banner }}" alt=""></div>
<div class="infobar"><div class="wrap">
  <span class="ib-name">{{ conf.full_name }}</span>
  <span class="ib-item"><b>{{ conf.dates }}</b></span>
  <span class="ib-item">{{ conf.location }}</span>
  <a class="btn ib-btn" href="/calls/dates/">Important dates</a>
</div></div>
{% else %}
<div class="pagehead"><div class="wrap">
  {{ m.crumbs(page.url, title) }}
  <h1 class="title">{{ title }}</h1>
</div></div>
{% endif %}

<div class="wrap page{% if g and not home %} has-sec{% endif %}">
  {%- if g and not home %}
  <nav class="secnav" aria-label="{{ g.name }}">
    <details class="sec-d" open><summary>{{ g.name }}</summary>{{ m.items(g.items, page.url) }}</details>
  </nav>
  {%- endif %}
  <main id="main" tabindex="-1">
    {%- if home %}<h1 class="title">{{ title }}</h1>{% endif %}
    <div class="prose">{{ content | safe }}</div>
    {%- if not isSoon %}<p class="edit">Edit this page: <code>{% editPath page.inputPath %}</code></p>{% endif %}
  </main>
  <aside class="side">{% upcoming 5 %}</aside>
</div>

{% include "_shared/logobar.njk" %}
<footer class="foot">
  <div class="wrap map">
    {%- for grp in nav.all %}{% if not loop.first %}
    <section><h2>{{ grp.name }}</h2>{{ m.items(grp.items, page.url) }}</section>
    {%- endif %}{% endfor %}
  </div>
  <div class="wrap colophon"><span><b>{{ conf.short_name }}</b> · {{ conf.dates }} · {{ conf.location }}</span><span>{{ m.foot_links(site) }}</span></div>
</footer>
</body>
</html>
