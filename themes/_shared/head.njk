<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == "/" %}{{ conf.short_name }} · {{ conf.location }}{% else %}{{ title }} · {{ conf.short_name }}{% endif %}</title>
<meta name="description" content="{{ conf.full_name }}, {{ conf.dates }}, {{ conf.location }}.">
<link rel="icon" href="/{{ conf.logo }}" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/base.css">
<link rel="stylesheet" href="/assets/theme.css">
<style>:root { --accent: {{ conf.accent_color or "#0f766e" }}; }</style>
<script src="/assets/site.js" defer></script>
