{%- import "_shared/macros.njk" as m -%}
{%- set home = page.url == "/" -%}
{%- set g = page.url | groupOf -%}
<!doctype html>
<html lang="en">
<head>
{% include "_shared/head.njk" %}
</head>
<body class="theme-handbook{% if home %} is-home{% endif %}">
<a class="skip" href="#main">Skip to content</a>
<header class="bar">
  <div class="bar-in">
    <a class="brand" href="/"><span class="logo">{% logo "h" %}</span><span class="name">{{ conf.short_name | yearEm | safe }}</span></a>
    <span class="when">{{ conf.dates }} · {{ conf.location }}</span>
    <a class="btn reg" href="{{ conf.register_link }}">Register</a>
    <button class="menubtn" data-menu aria-expanded="false" aria-controls="sidebar">Menu</button>
  </div>
</header>
{% if site.announcement %}<div class="announce"><div class="bar-in">{{ site.announcement | inline | safe }}</div></div>{% endif %}

<div class="shell">
  <nav class="sidebar drawer" id="sidebar" aria-label="Site">
    {%- for grp in nav.all %}
    <details class="sgrp"{% if grp == g or (home and loop.first) %} open{% endif %}>
      <summary>{{ grp.name }}</summary>
      {{ m.items(grp.items, page.url) }}
    </details>
    {%- endfor %}
    <p class="drawer-cta"><a class="btn" href="{{ conf.register_link }}">Register</a></p>
  </nav>

  <main id="main" tabindex="-1">
    {%- if home %}
    <section class="intro">
      <img src="/{{ conf.banner }}" alt="">
      <div class="intro-txt">
        <p class="kicker">{{ conf.full_name }}</p>
        <p class="big">{{ conf.dates }}<br><span>{{ conf.location }}</span></p>
        <p class="cta"><a class="btn" href="{{ conf.register_link }}">Register</a> <a class="btn ghost" href="/calls/dates/">Important dates</a></p>
      </div>
    </section>
    <div class="home-up">{% upcoming 4 %}</div>
    {%- else %}
    {{ m.crumbs(page.url, title) }}
    {%- endif %}
    <article class="doc">{{ m.body(title, content, page, isSoon) }}</article>
    {%- if g and not home %}
    {%- set fl = g.items -%}
    <nav class="pager" aria-label="More in {{ g.name }}"><span>More in {{ g.name }}:</span>
      {%- for i in fl %}{% if not i.children and i.href != page.url and not i.external %} <a href="{{ i.href }}">{{ i.title }}</a>{% endif %}{% endfor %}
    </nav>
    {%- endif %}
  </main>

  <aside class="rail" aria-label="Upcoming dates">{% if not home %}{% upcoming 5 %}{% endif %}</aside>
</div>

<footer class="foot">
  <div class="bar-in">
    <span><b>{{ conf.short_name }}</b> · {{ conf.dates }} · {{ conf.location }}</span>
    <span>{{ m.foot_links(site) }}</span>
  </div>
</footer>
</body>
</html>
