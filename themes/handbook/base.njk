{%- import "_shared/macros.njk" as m -%}
{%- set home = page.url == "/" -%}
{%- set g = page.url | groupOf -%}
{%- set body = content | headingIds -%}
{%- set toc = body | toc -%}
{%- set nb = page.url | neighbors -%}
<!doctype html>
<html lang="en">
<head>
{% include "_shared/head.njk" %}
</head>
<body class="theme-handbook{% if home %} is-home{% endif %}">
<a class="skip" href="#main">Skip to content</a>
<header class="bar">
  <div class="bar-in">
    <a class="brand" href="/"><span class="logo">{% logo "h" %}</span><span class="name">{{ conf.short_name | yearEm | safe }}</span></a>
    <span class="when">{{ conf.dates }} · {{ conf.location }}</span>
    <a class="btn reg" href="{{ conf.register_link }}">Register</a>
    <button class="menubtn" data-menu aria-expanded="false" aria-controls="sidebar">Menu</button>
  </div>
</header>
{% if site.announcement %}<div class="announce"><div class="bar-in">{{ site.announcement | inline | safe }}</div></div>{% endif %}

<div class="shell">
  <nav class="sidebar drawer" id="sidebar" aria-label="Site">
    <input class="filter" type="search" placeholder="Find a page…" aria-label="Find a page in the menu" data-filter=".sgrp" hidden>
    {%- for grp in nav.all %}
    {%- set isOpen = grp == g or (home and loop.first) %}
    <details class="sgrp"{% if isOpen %} open data-open{% endif %}>
      <summary>{{ grp.name }}</summary>
      {{ m.items(grp.items, page.url) }}
    </details>
    {%- endfor %}
    <p class="drawer-cta"><a class="btn" href="{{ conf.register_link }}">Register</a></p>
  </nav>

  <main id="main" tabindex="-1">
    {%- if home %}
    <div class="intro-img"><img src="/{{ conf.banner }}" alt=""></div>
    <section class="intro">
      <p class="kicker">{{ conf.full_name }}</p>
      <p class="big">{{ conf.short_name | yearEm | safe }}</p>
      <dl class="facts">
        <div><dt>When</dt><dd>{{ conf.dates }}</dd></div>
        <div><dt>Where</dt><dd>{{ conf.location }}<small>{{ conf.venue }}</small></dd></div>
        <div><dt>Next deadline</dt><dd>{% deadlines 1, "fact" %}</dd></div>
      </dl>
      <p class="cta"><a class="btn" href="{{ conf.register_link }}">Register</a> <a class="btn ghost" href="/calls/dates/">Important dates</a></p>
    </section>
    {%- else %}
    {{ m.crumbs(page.url, title) }}
    {%- endif %}
    <article class="doc">
      <h1 class="title">{{ title }}</h1>
      <div class="prose">{{ body | safe }}</div>
      {%- if not isSoon %}<p class="edit">Edit this page: <code>{% editPath page.inputPath %}</code></p>{% endif %}
    </article>
    {%- if not home and (nb.prev or nb.next) %}
    <nav class="prevnext" aria-label="Previous and next in {{ nb.group.name }}">
      {%- if nb.prev %}<a class="pv{% if not nb.prev.exists %} is-soon{% endif %}" href="{{ nb.prev.href }}"><small>← Previous</small>{{ nb.prev.title }}</a>{% endif %}
      {%- if nb.next %}<a class="nx{% if not nb.next.exists %} is-soon{% endif %}" href="{{ nb.next.href }}"><small>Next →</small>{{ nb.next.title }}</a>{% endif %}
    </nav>
    {%- endif %}
  </main>

  <aside class="rail" aria-label="On this page and upcoming dates">
    {%- if toc.length > 1 %}
    <nav class="toc" aria-label="On this page"><h2>On this page</h2><ul>{% for h in toc %}<li><a href="#{{ h.id }}">{{ h.text }}</a></li>{% endfor %}</ul></nav>
    {%- endif %}
    {% upcoming 4 %}
  </aside>
</div>

{% include "_shared/logobar.njk" %}
<footer class="foot">
  <div class="bar-in">
    <span><b>{{ conf.short_name }}</b> · {{ conf.dates }} · {{ conf.location }}</span>
    <span>{{ m.foot_links(site) }}</span>
  </div>
</footer>
</body>
</html>
