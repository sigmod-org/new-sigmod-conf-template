{%- import "_shared/macros.njk" as m -%}
{%- set home = page.url == "/" -%}
{%- set g = page.url | groupOf -%}
{%- set body = content | headingIds -%}
{%- set toc = body | toc -%}
<!doctype html>
<html lang="en">
<head>
{% include "_shared/head.njk" %}
</head>
<body class="theme-landing{% if home %} is-home{% endif %}">
<a class="skip" href="#main">Skip to content</a>
{% if site.announcement %}<div class="announce"><div class="wrap">{{ site.announcement | inline | safe }}</div></div>{% endif %}

<header class="masthead">
  <div class="wrap top">
    <a class="brand" href="/"><span class="logo">{% logo "h" %}</span><span class="name">{{ conf.short_name | yearEm | safe }}</span></a>
    <span class="when">{{ conf.dates }} · {{ conf.location }}</span>
    <a class="btn reg" href="{{ conf.register_link }}">Register</a>
  </div>
  <nav class="tabs" aria-label="Sections">
    <ul class="wrap">
      <li><a href="/"{% if g == nav.all[0] %} class="cur"{% endif %}>Home</a></li>
      {%- for grp in nav.all %}{% if not loop.first %}
      <li><a href="{{ grp.first.href }}"{% if grp == g %} class="cur" aria-current="true"{% endif %}>{{ grp.short }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
  </nav>
</header>

{% if home %}
<section class="hero">
  <img src="/{{ conf.banner }}" alt="">
  <div class="wrap">
    <div class="hero-txt">
      <h1 class="hero-title">{{ conf.short_name | yearEm | safe }}</h1>
      <p class="hero-full">{{ conf.full_name }}</p>
    </div>
  </div>
</section>
<section class="wrap facts" aria-label="Key facts">
  <div><span>When</span><b>{{ conf.dates }}</b></div>
  <div><span>Where</span><b>{{ conf.location }}</b><small>{{ conf.venue }}</small></div>
  <div class="f-next"><span>Next deadline</span>{% deadlines 1, "fact" %}</div>
  <div class="f-cta"><a class="btn" href="{{ conf.register_link }}">Register</a><a class="btn ghost" href="/calls/dates/">Important dates</a></div>
</section>

<section class="wrap band">
  <div class="band-h"><h2>Next deadlines</h2>{% if site.dates_note_short %}<span class="upnote">{{ site.dates_note_short }}</span>{% endif %}<a href="/calls/dates/">All dates →</a></div>
  <div>{% deadlines 4 %}</div>
</section>

<section class="wrap band" aria-label="Every page on this site">
  <div class="band-h"><h2>Find your way</h2></div>
  <div class="quick">
    {%- for grp in nav.all %}{% if not loop.first %}
    <details class="qcard" open>
      <summary>{{ grp.name }}</summary>
      {{ m.items(grp.items, page.url) }}
    </details>
    {%- endif %}{% endfor %}
  </div>
</section>
{% else %}
<section class="sechead">
  <div class="wrap">
    <p class="eyebrow">{{ g.name if g else conf.short_name }}</p>
    <h1 class="title">{{ title }}</h1>
    {%- if g %}
    <nav class="pills" aria-label="{{ g.name }}">
      {%- for i in g.items %}
        {%- if i.children %}{% for c in i.children %}<a href="{{ c.href }}"{% if c.href == page.url %} aria-current="page"{% endif %}>{{ i.title }}: {{ c.title }}</a>{% endfor %}
        {%- else %}<a href="{{ i.href }}"{% if i.href == page.url %} aria-current="page"{% endif %}>{{ i.title }}{% if i.external %} ↗{% endif %}</a>{% endif %}
      {%- endfor %}
    </nav>
    {%- endif %}
  </div>
</section>
{% endif %}

<div class="wrap page">
  <main id="main" tabindex="-1">
    {%- if home %}<h2 class="title home-h">{{ title }}</h2>{% endif %}
    <div class="prose">{{ body | safe }}</div>
    {%- if not isSoon %}<p class="edit">Edit this page: <code>{% editPath page.inputPath %}</code></p>{% endif %}
  </main>
  <aside class="side">
    {%- if toc.length > 1 %}
    <nav class="toc" aria-label="On this page"><h2>On this page</h2><ul>{% for h in toc %}<li><a href="#{{ h.id }}">{{ h.text }}</a></li>{% endfor %}</ul></nav>
    {%- endif %}
    {%- if not home %}{% upcoming 4 %}{% endif %}
  </aside>
</div>

{% include "_shared/logobar.njk" %}
<footer class="foot">
  <div class="wrap">
    <div class="fl"><div><b>{{ conf.short_name }}</b><br>{{ conf.dates }} · {{ conf.location }}</div></div>
    <div class="fr">{{ m.foot_links(site) }}</div>
  </div>
</footer>
</body>
</html>
